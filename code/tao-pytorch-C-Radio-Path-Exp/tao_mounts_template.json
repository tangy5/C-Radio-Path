{
    "Mounts": [
        {
            "source": "<CLUSTER_WORKSPACE>/teacher_models",
            "destination": "/workspace/teacher_models"
        },
        {
            "source": "<CLUSTER_WORKSPACE>/tao-pytorch-custom-build",
            "destination": "/tao-pt"
        },
        {
